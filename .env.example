# Copy to .env and fill in. Never commit .env.
# Used by `docker compose` (api service) and by `npm run dev` (the API reads ../../.env).

NODE_ENV=development
PORT=4000

# For `npm run dev`: MySQL from compose is published on host port 3307.
# Inside Docker, compose overrides this to point at the `db` service.
# Amazon RDS: mysql://USER:PASSWORD@HOST:3306/portfolio?ssl=Amazon%20RDS   (TLS with the RDS certificates)
DATABASE_URL=mysql://portfolio:portfolio@localhost:3307/portfolio

# Frontend origin(s) allowed to call the API from the browser, comma-separated
CORS_ORIGINS=http://localhost:3000

# Optional: host port for the website in Docker (default 3000). If you change it, add
# http://localhost:<port> to CORS_ORIGINS above so the browser may call the API.
# WEB_PORT=3002

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password -w apps/api -- "your-strong-password"   (keep the single quotes)
ADMIN_PASSWORD_HASH='$2b$12$replace-with-output-of-hash-password'

# Optional: email notifications for new contact messages (https://resend.com).
# Leave empty and messages are only saved to the database (visible in the admin inbox).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
